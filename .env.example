# База данных SQLite
# ВАЖНО: Путь указывается ОТНОСИТЕЛЬНО файла prisma/schema.prisma
# prisma/schema.prisma находится в папке prisma/, поэтому:
# - ../db/custom.db = корень_проекта/db/custom.db (ПРАВИЛЬНО)
# - ./db/custom.db = prisma/db/custom.db (НЕПРАВИЛЬНО)

DATABASE_URL=file:../db/custom.db

# Для продакшена можно использовать абсолютный путь:
# DATABASE_URL=file:/var/app/uIIa-analise/db/custom.db

# После клонирования репозитория выполните:
# 1. cp .env.example .env
# 2. bun install
# 3. bunx prisma generate
# 4. bun run db:push
# 5. bun run db:seed
